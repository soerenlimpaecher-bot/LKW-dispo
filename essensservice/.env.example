# Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Nur serverseitig! Nie mit NEXT_PUBLIC_ beginnen lassen.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Öffentliche Basis-URL für persönliche Links, z. B. https://essen.agrarlohn-mueritz.de
APP_BASE_URL=http://localhost:3000

# Web Push (erzeugen mit: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public>
VAPID_PRIVATE_KEY=<vapid-private>
VAPID_SUBJECT=mailto:<kontakt-adresse-des-betriebs>

# Schutz für Cron-Aufrufe (Wiederholung fehlgeschlagener Push-Nachrichten)
CRON_SECRET=<zufaelliger-langer-wert>

# Nur für Tests: lokale Postgres-Datenbank
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/essen_test
